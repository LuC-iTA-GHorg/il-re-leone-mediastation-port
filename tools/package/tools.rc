/* Windows resources of the development tools (msdump.exe, selftest*.exe, test helpers): the
 * port's icon and version information, so that antivirus heuristics (Kaspersky) do not flag
 * unsigned executables without any metadata. Compiled by build.bat into tools_res.o. */
#include <winver.h>

1 ICON "lionking.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "041004B0"
		BEGIN
			VALUE "CompanyName",      "LuC-iTA-GHorg (port non ufficiale)"
			VALUE "FileDescription",  "Il Re Leone port SDL2 - strumento di sviluppo (dati, script, prove)"
			VALUE "FileVersion",      "1.0.0.0"
			VALUE "InternalName",     "msdump"
			VALUE "ProductName",      "Il Re Leone - Libro Animato Interattivo (port SDL2)"
			VALUE "ProductVersion",   "1.0.0.0"
			VALUE "LegalCopyright",   "Codice del port: LuC-iTA-GHorg. Il gioco e i suoi dati appartengono ai rispettivi proprietari e non sono inclusi."
			VALUE "Comments",         "Strumento a riga di comando del port non ufficiale; non modifica i file del gioco."
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0410, 1200
	END
END
