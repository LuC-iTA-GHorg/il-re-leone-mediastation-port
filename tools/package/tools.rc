/* Windows resources of the development tools (msdump.exe, selftest*.exe, test helpers): the
 * port's icon and version information, so that antivirus heuristics (Kaspersky) do not flag
 * unsigned executables without any metadata. Compiled by build.bat into tools_res.o. */
#include <winver.h>

1 ICON "lionking.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",    "LuC-iTA-GHorg (unofficial port)"
			VALUE "FileDescription", "Il Re Leone SDL2 port - development tool (data, scripts, tests)"
			VALUE "FileVersion",      "1.0.0.0"
			VALUE "InternalName",     "msdump"
			VALUE "ProductName",    "Il Re Leone - Libro Animato Interattivo (SDL2 port)"
			VALUE "ProductVersion",   "1.0.0.0"
			VALUE "LegalCopyright", "Port code: LuC-iTA-GHorg. The game and its data belong to their respective owners and are not included."
			VALUE "Comments",       "Command-line tool of the unofficial port; it does not modify the game files."
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
